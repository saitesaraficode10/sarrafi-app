<%- include('../partials/header') %>
<div class="page-title">
  <h1>اطلاعات حساب‌های واریز</h1>
  <a class="btn btn-ghost" href="/admin">← داشبورد</a>
</div>
<p class="muted">برای ویرایش، فیلد را کامل پاک کنید و دوباره بنویسید. شماره‌ها چپ‌به‌راست نمایش داده می‌شوند.</p>
<% banks.forEach(b => { %>
<form method="POST" action="/admin/payments/update" class="panel stack" style="margin-top:0.85rem" autocomplete="off">
  <input type="hidden" name="id" value="<%= b.id %>">
  <div style="font-weight:800;color:var(--gold)"><%= b.bank_name %></div>
  <div>
    <label class="label">شماره کارت</label>
    <input class="input ltr-num" type="text" name="card_number" value="<%= b.card_number || '' %>"
           autocomplete="off" inputmode="numeric" dir="ltr" placeholder="6037-xxxx-xxxx-xxxx">
  </div>
  <div>
    <label class="label">شبا</label>
    <input class="input ltr-num" type="text" name="shaba" value="<%= b.shaba || '' %>"
           autocomplete="off" dir="ltr" placeholder="IR00...">
  </div>
  <div>
    <label class="label">صاحب حساب</label>
    <input class="input" type="text" name="account_holder" value="<%= b.account_holder || '' %>" autocomplete="off">
  </div>
  <label class="muted" style="display:flex;gap:0.4rem;align-items:center">
    <input type="checkbox" name="is_active" value="1" <%= b.is_active ? 'checked' : '' %>> فعال
  </label>
  <button class="btn btn-gold" type="submit">ذخیره</button>
</form>
<% }) %>
<%- include('../partials/footer') %>

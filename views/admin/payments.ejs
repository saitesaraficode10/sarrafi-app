<%- include('../partials/header') %>
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">اطلاعات حساب‌های واریز</h1>
  <a href="/admin" class="text-blue-600">← داشبورد</a>
</div>
<div class="space-y-4">
  <% banks.forEach(b => { %>
  <form method="POST" action="/admin/payments/update" class="bg-white rounded-xl shadow p-4 space-y-3">
    <input type="hidden" name="id" value="<%= b.id %>">
    <div class="font-bold"><%= b.bank_name %></div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <div>
        <label class="text-xs">شماره کارت</label>
        <input type="text" name="card_number" value="<%= b.card_number %>" class="w-full border rounded px-2 py-1">
      </div>
      <div>
        <label class="text-xs">شبا</label>
        <input type="text" name="shaba" value="<%= b.shaba %>" class="w-full border rounded px-2 py-1">
      </div>
      <div>
        <label class="text-xs">صاحب حساب</label>
        <input type="text" name="account_holder" value="<%= b.account_holder %>" class="w-full border rounded px-2 py-1">
      </div>
    </div>
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="is_active" value="1" <%= b.is_active ? 'checked' : '' %>> فعال
    </label>
    <button type="submit" class="bg-blue-600 text-white px-4 py-1 rounded text-sm">ذخیره</button>
  </form>
  <% }) %>
</div>
<%- include('../partials/footer') %>

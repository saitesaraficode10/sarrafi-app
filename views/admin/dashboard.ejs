<%- include('../partials/header') %>
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">پنل ادمین — <%= admin.username %></h1>
  <a href="/admin/logout" class="text-red-600">خروج</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
  <div class="bg-white rounded-xl shadow p-5 text-center">
    <div class="text-3xl font-bold text-blue-600"><%= stats.users %></div>
    <div class="text-gray-500">کاربران</div>
  </div>
  <div class="bg-white rounded-xl shadow p-5 text-center">
    <div class="text-3xl font-bold text-yellow-600"><%= stats.pending %></div>
    <div class="text-gray-500">در انتظار</div>
  </div>
  <div class="bg-white rounded-xl shadow p-5 text-center">
    <div class="text-3xl font-bold text-green-600"><%= stats.completed %></div>
    <div class="text-gray-500">تکمیل شده</div>
  </div>
</div>
<div class="flex flex-wrap gap-3 mb-6">
  <a href="/admin/users" class="bg-blue-600 text-white px-4 py-2 rounded-lg">کاربران</a>
  <a href="/admin/transactions" class="bg-blue-600 text-white px-4 py-2 rounded-lg">تراکنش‌ها</a>
  <a href="/admin/rates" class="bg-blue-600 text-white px-4 py-2 rounded-lg">نرخ‌ها</a>
  <a href="/admin/payments" class="bg-blue-600 text-white px-4 py-2 rounded-lg">اطلاعات واریز</a>
  <a href="/admin/cash-in" class="bg-amber-600 text-white px-4 py-2 rounded-lg">تحویل درام نقدی</a>
</div>
<h2 class="text-xl font-semibold mb-3">آخرین تراکنش‌ها</h2>
<div class="overflow-x-auto bg-white rounded-xl shadow">
  <table class="w-full text-sm">
    <thead class="bg-gray-100"><tr>
      <th class="p-3 text-right">کد</th><th class="p-3 text-right">کاربر</th><th class="p-3 text-right">جفت</th><th class="p-3 text-right">وضعیت</th><th class="p-3"></th>
    </tr></thead>
    <tbody>
      <% recentTx.forEach(tx => { %>
      <tr class="border-t">
        <td class="p-3 font-mono"><%= tx.transaction_code %></td>
        <td class="p-3"><%= tx.first_name %> <%= tx.last_name %> (<%= tx.user_code %>)</td>
        <td class="p-3"><%= tx.pair %></td>
        <td class="p-3"><%= tx.status %></td>
        <td class="p-3"><a href="/admin/transaction/<%= tx.transaction_code %>" class="text-blue-600">جزئیات</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

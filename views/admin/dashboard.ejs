<%- include('../partials/header') %>
<div class="page-title">
  <h1>پنل ادمین — <%= admin.username %></h1>
  <a class="btn btn-ghost" href="/admin/logout">خروج</a>
</div>

<div class="admin-stats">
  <div class="admin-stat"><b><%= stats.users %></b><span class="muted">کاربران</span></div>
  <div class="admin-stat"><b><%= stats.pending %></b><span class="muted">در انتظار</span></div>
  <div class="admin-stat"><b><%= stats.completed %></b><span class="muted">تکمیل شده</span></div>
</div>

<nav class="admin-nav">
  <a href="/admin/users">👥 کاربران</a>
  <a href="/admin/transactions">💳 تراکنش‌ها</a>
  <a href="/admin/rates">📈 نرخ‌ها (دستی)</a>
  <a href="/admin/payments">🏦 اطلاعات واریز</a>
  <a href="/admin/cash-in">💵 تحویل درام نقدی</a>
  <a href="/admin/settings">⚙️ تنظیمات دفتر</a>
</nav>

<h2 style="margin:1.25rem 0 0.6rem;font-size:1.1rem">آخرین تراکنش‌ها</h2>
<div class="table-wrap panel" style="padding:0">
  <table>
    <thead>
      <tr><th>کد</th><th>کاربر</th><th>جفت</th><th>وضعیت</th><th></th></tr>
    </thead>
    <tbody>
      <% if (typeof recentTx !== 'undefined' && recentTx.length) { %>
        <% recentTx.forEach(tx => { %>
          <tr>
            <td><code><%= tx.transaction_code %></code></td>
            <td><%= tx.first_name %> <%= tx.last_name %> (<%= tx.user_code %>)</td>
            <td><%= tx.pair %></td>
            <td><%= tx.status %></td>
            <td><a href="/admin/transaction/<%= tx.transaction_code %>" style="color:var(--gold)">جزئیات</a></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5" class="muted" style="text-align:center;padding:1.5rem">هنوز تراکنشی نیست</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

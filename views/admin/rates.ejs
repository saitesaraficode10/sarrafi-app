<%- include('../partials/header') %>
<div class="page-title">
  <h1>مدیریت نرخ‌ها</h1>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
    <form method="POST" action="/admin/rates/refresh">
      <button class="btn btn-soft" type="submit">API</button>
    </form>
    <a class="btn btn-ghost" href="/admin">← داشبورد</a>
  </div>
</div>
<% if (typeof ok !== 'undefined' && ok) { %>
  <div class="alert" style="background:rgba(52,211,153,0.12);color:#6ee7b7;border-color:rgba(52,211,153,0.3)">ذخیره شد ✓</div>
<% } %>
<p class="muted">هر ردیف فقط یک جهت است. مثال: IRR→AMD خرید ۲۱۵ / فروش ۲۰۰</p>

<% rates.forEach(r => { %>
<form method="POST" action="/admin/rates/update" class="panel" style="margin-top:0.75rem">
  <input type="hidden" name="pair" value="<%= r.pair %>">
  <div style="display:flex;justify-content:space-between;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.6rem">
    <div style="font-weight:800;color:var(--gold);font-family:monospace"><%= r.pair %></div>
    <div class="muted" style="font-size:0.8rem">
      <% if (r.pair==='USD_AMD') { %>دلار → درام
      <% } else if (r.pair==='USDT_AMD') { %>تتر → درام
      <% } else if (r.pair==='IRR_AMD') { %>تومان → درام
      <% } else if (r.pair==='RUB_AMD') { %>روبل → درام
      <% } %>
    </div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem">
    <div>
      <label class="label">خرید (Buy)</label>
      <input class="input" type="number" step="any" name="buy_rate" value="<%= r.buy_rate %>" required>
    </div>
    <div>
      <label class="label">فروش (Sell)</label>
      <input class="input" type="number" step="any" name="sell_rate" value="<%= r.sell_rate %>" required>
    </div>
  </div>
  <div style="margin-top:0.75rem;display:flex;justify-content:space-between;align-items:center">
    <span class="muted" style="font-size:0.75rem"><%= r.is_manual ? 'دستی' : (r.source || '') %></span>
    <button class="btn btn-gold" type="submit">ذخیره</button>
  </div>
</form>
<% }) %>
<%- include('../partials/footer') %>

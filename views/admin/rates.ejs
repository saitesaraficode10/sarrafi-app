<%- include('../partials/header') %>
<div class="page-title">
  <h1>مدیریت نرخ‌ها (دستی)</h1>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
    <form method="POST" action="/admin/rates/refresh">
      <button class="btn btn-soft" type="submit">به‌روزرسانی از API</button>
    </form>
    <a class="btn btn-ghost" href="/admin">← داشبورد</a>
  </div>
</div>
<p class="muted">هر نرخ را دستی ذخیره کنید. بعد از ذخیره دستی، آن جفت از API عوض نمی‌شود تا دوباره Refresh بزنید.</p>

<% rates.forEach(r => { %>
<form method="POST" action="/admin/rates/update" class="panel rate-edit" style="margin-top:0.75rem">
  <input type="hidden" name="pair" value="<%= r.pair %>">
  <div>
    <div class="label">جفت</div>
    <div style="font-weight:800;font-family:monospace"><%= r.pair %></div>
  </div>
  <div>
    <label class="label">خرید</label>
    <input class="input" type="number" step="any" name="buy_rate" value="<%= r.buy_rate %>">
  </div>
  <div>
    <label class="label">فروش</label>
    <input class="input" type="number" step="any" name="sell_rate" value="<%= r.sell_rate %>">
  </div>
  <div>
    <button class="btn btn-gold" type="submit">ذخیره دستی</button>
    <div class="muted" style="font-size:0.75rem;margin-top:0.35rem">
      <%= r.source %> · <%= r.is_manual ? 'دستی' : 'API' %>
    </div>
  </div>
</form>
<% }) %>
<%- include('../partials/footer') %>

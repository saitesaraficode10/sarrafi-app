<%- include('../partials/header') %>
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">کاربران</h1>
  <a href="/admin" class="text-blue-600">← داشبورد</a>
</div>
<form method="GET" class="mb-4 flex gap-2">
  <input type="text" name="q" value="<%= q %>" placeholder="جستجو با کد، نام یا شماره..." class="border rounded-lg px-3 py-2 flex-1">
  <button class="bg-blue-600 text-white px-4 py-2 rounded-lg">جستجو</button>
</form>
<div class="overflow-x-auto bg-white rounded-xl shadow">
  <table class="w-full text-sm">
    <thead class="bg-gray-100"><tr>
      <th class="p-3 text-right">کد</th><th class="p-3 text-right">نام</th><th class="p-3 text-right">تلفن</th><th class="p-3 text-right">تاریخ</th><th class="p-3"></th>
    </tr></thead>
    <tbody>
      <% users.forEach(u => { %>
      <tr class="border-t">
        <td class="p-3 font-mono font-bold"><%= u.user_code %></td>
        <td class="p-3"><%= u.first_name %> <%= u.last_name %></td>
        <td class="p-3"><%= u.phone_am %></td>
        <td class="p-3"><%= u.created_at %></td>
        <td class="p-3"><a href="/admin/user/<%= u.user_code %>" class="text-blue-600">مشاهده</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

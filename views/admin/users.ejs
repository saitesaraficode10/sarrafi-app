<%- include('../partials/header') %>
<div class="page-title">
  <h1>کاربران</h1>
  <a class="btn btn-ghost" href="/admin">← داشبورد</a>
</div>
<form method="GET" class="panel" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-bottom:1rem">
  <input class="input" style="flex:1;min-width:180px" type="text" name="q" value="<%= q || '' %>" placeholder="جستجو با کد، نام یا شماره...">
  <button class="btn btn-gold" type="submit">جستجو</button>
</form>
<div class="table-wrap panel" style="padding:0">
  <table>
    <thead>
      <tr><th>کد</th><th>نام</th><th>تلفن</th><th>تاریخ</th><th></th></tr>
    </thead>
    <tbody>
      <% if (users && users.length) { %>
        <% users.forEach(u => { %>
          <tr>
            <td><b style="color:var(--gold)"><%= u.user_code %></b></td>
            <td><%= u.first_name %> <%= u.last_name %></td>
            <td><%= u.phone_am %></td>
            <td class="muted"><%= u.created_at %></td>
            <td style="display:flex;gap:0.4rem;flex-wrap:wrap">
              <a class="btn btn-soft" style="padding:0.3rem 0.7rem" href="/admin/user/<%= u.user_code %>">مشاهده</a>
              <form method="POST" action="/admin/user/<%= u.user_code %>/delete" onsubmit="return confirm('کاربر حذف شود؟');">
                <button class="btn btn-ghost" style="padding:0.3rem 0.7rem;color:#fb7185" type="submit">حذف</button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5" class="muted" style="text-align:center;padding:1.5rem">کاربری نیست</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

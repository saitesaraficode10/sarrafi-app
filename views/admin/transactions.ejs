<%- include('../partials/header') %>
<div class="page-title">
  <h1>تراکنش‌ها</h1>
  <a class="btn btn-ghost" href="/admin">← داشبورد</a>
</div>
<div class="admin-nav">
  <a href="/admin/transactions">همه</a>
  <a href="/admin/transactions?status=pending_payment">در انتظار واریز</a>
  <a href="/admin/transactions?status=pending_declaration">اعلامیه</a>
  <a href="/admin/transactions?status=pending_review">در بررسی</a>
  <a href="/admin/transactions?status=ready_pickup">آماده دریافت</a>
  <a href="/admin/transactions?status=completed">تکمیل</a>
</div>
<div class="table-wrap panel" style="padding:0">
  <table>
    <thead>
      <tr><th>کد</th><th>کاربر</th><th>جفت</th><th>مبلغ</th><th>وضعیت</th><th></th></tr>
    </thead>
    <tbody>
      <% if (txs && txs.length) { %>
        <% txs.forEach(tx => { %>
          <tr>
            <td><code><%= tx.transaction_code %></code></td>
            <td><%= tx.first_name %> <%= tx.last_name %> (<%= tx.user_code %>)</td>
            <td><%= tx.pair %></td>
            <td><%= tx.amount_from %></td>
            <td><%= tx.status %></td>
            <td><a href="/admin/transaction/<%= tx.transaction_code %>" style="color:var(--gold)">مدیریت</a></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="6" class="muted" style="text-align:center;padding:1.5rem">تراکنشی نیست</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div class="page-title">
  <h1>تراکنش <span class="ltr-num" dir="ltr"><%= tx.transaction_code %></span></h1>
  <a class="btn btn-ghost" href="/admin/transactions">← لیست</a>
</div>
<div class="panel stack" style="margin-bottom:1rem">
  <div>کاربر: <%= tx.first_name %> <%= tx.last_name %> (<%= tx.user_code %>)</div>
  <div>تلفن: <span class="ltr-num" dir="ltr"><%= tx.phone_am %></span> · واتساپ: <span class="ltr-num" dir="ltr"><%= tx.whatsapp %></span></div>
  <div><%= tx.pair %> · <%= Number(tx.amount_from).toLocaleString() %> → <%= Number(tx.amount_to).toLocaleString() %></div>
  <div>وضعیت: <b><%= statusLabel(tx.status) %></b></div>
  <% if (tx.receipt_path) { %><div><a href="/admin/receipt/<%= tx.transaction_code %>" target="_blank" style="color:var(--gold)">مشاهده رسید آپلودشده</a></div><% } %>
  <% if (tx.declaration_filled) { %>
    <a class="btn btn-soft" href="/admin/transaction/<%= tx.transaction_code %>/print-declaration" target="_blank">چاپ اعلامیه (با بخش ۶ دفتر)</a>
  <% } %>
</div>

<form method="POST" action="/admin/transaction/<%= tx.transaction_code %>/update" class="panel stack">
  <div>
    <label class="label">وضعیت</label>
    <select class="input" name="status">
      <option value="pending_payment" <%= tx.status==='pending_payment'?'selected':'' %>>در انتظار واریز</option>
      <option value="pending_declaration" <%= tx.status==='pending_declaration'?'selected':'' %>>در انتظار اعلامیه</option>
      <option value="pending_review" <%= tx.status==='pending_review'?'selected':'' %>>در انتظار بررسی</option>
      <option value="ready_pickup" <%= tx.status==='ready_pickup'?'selected':'' %>>آماده حضور در دفتر</option>
      <option value="completed" <%= tx.status==='completed'?'selected':'' %>>تکمیل شده</option>
      <option value="rejected" <%= tx.status==='rejected'?'selected':'' %>>رد شده</option>
    </select>
  </div>
  <div class="box-card">
    <h3>وقت حضور در دفتر (برای مشتری)</h3>
    <label class="label">تاریخ (میلادی)</label>
    <input class="input" type="date" name="office_date" value="<%= tx.office_date || '' %>">
    <label class="label">ساعت</label>
    <input class="input" type="time" name="office_time" value="<%= tx.office_time || '' %>" step="60" style="direction:ltr">
    <label class="label">آدرس دفتر</label>
    <input class="input" type="text" name="office_address" value="<%= tx.office_address || '' %>" placeholder="آدرس کامل">
    <label class="label">متن آزاد وقت (اختیاری)</label>
    <input class="input" type="text" name="pickup_time" value="<%= tx.pickup_time || '' %>">
  </div>
  <div class="box-card">
    <h3>بخش ۶ — فقط دفتر</h3>
    <label class="label">نام دریافت‌کننده</label>
    <input class="input" name="receiver_name" value="<%= tx.receiver_name || '' %>">
    <label class="label">تاریخ دریافت و امضاء</label>
    <input class="input" name="receive_sign_date" value="<%= tx.receive_sign_date || '' %>" placeholder="تاریخ + امضاء">
    <label class="label">شماره رهگیری بانکی (در صورت نیاز)</label>
    <input class="input ltr-num" dir="ltr" name="tracking_bank" value="">
  </div>
  <div>
    <label class="label">یادداشت ادمین</label>
    <textarea class="input" name="admin_note" rows="2"><%= tx.admin_note || '' %></textarea>
  </div>
  <button class="btn btn-gold" type="submit">ذخیره</button>
</form>
<%- include('../partials/footer') %>

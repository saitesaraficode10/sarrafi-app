<%- include('../partials/header') %>
<div class="max-w-lg mx-auto bg-white rounded-xl shadow-lg p-6">
  <h1 class="text-2xl font-bold mb-6"><%= t('new_order') %></h1>
  <% if (error) { %><div class="bg-red-100 text-red-700 p-3 rounded mb-4"><%= error %></div><% } %>
  <form method="POST" action="/new-order" class="space-y-4">
    <div>
      <label class="block text-sm mb-1">جفت ارز</label>
      <select name="pair" required class="w-full border rounded-lg px-3 py-2">
        <% rates.forEach(r => { %>
          <option value="<%= r.pair %>"><%= r.pair %> (فروش: <%= r.sell_rate %>)</option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-sm mb-1"><%= t('amount') %> (از ارز مبدا)</label>
      <input type="number" name="amount_from" step="any" min="0.01" required class="w-full border rounded-lg px-3 py-2">
    </div>
    <div>
      <label class="block text-sm mb-1">بانک برای واریز</label>
      <select name="bank_name" required class="w-full border rounded-lg px-3 py-2">
        <% banks.forEach(b => { %>
          <option value="<%= b.bank_name %>"><%= b.bank_name %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700"><%= t('submit') %></button>
  </form>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-lg p-6">
  <h1 class="text-2xl font-bold mb-2">تحویل درام نقدی</h1>
  <p class="text-gray-600 text-sm mb-6">
    اگر می‌خواهید درام نقدی تحویل دهید و معادل ریالی آن به شماره شبا/کارت شما در ایران واریز شود، این فرم را پر کنید.
  </p>

  <% if (error) { %>
    <div class="bg-red-100 text-red-700 p-3 rounded mb-4"><%= error %></div>
  <% } %>

  <% if (rate) { %>
  <div class="bg-blue-50 rounded-lg p-3 mb-6 text-sm">
    نرخ تقریبی فعلی AMD → IRR (تومان): خرید <%= Number(rate.buy_rate).toLocaleString() %> /
    فروش <%= Number(rate.sell_rate).toLocaleString() %>
    <span class="text-gray-500">(نرخ نهایی هنگام تحویل توافق می‌شود)</span>
  </div>
  <% } %>

  <form method="POST" action="/cash-in" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm mb-1 font-medium">مبلغ درام تحویلی *</label>
        <input type="number" name="amount_amd" step="any" min="1" required
               class="w-full border rounded-lg px-3 py-2" placeholder="مثلاً 100000">
      </div>
      <div>
        <label class="block text-sm mb-1 font-medium">مبلغ معادل تومان *</label>
        <input type="number" name="amount_toman" step="any" min="1" required
               class="w-full border rounded-lg px-3 py-2" placeholder="مبلغ توافقی به تومان">
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm mb-1 font-medium">تاریخ تحویل *</label>
        <input type="date" name="delivery_date" required class="w-full border rounded-lg px-3 py-2">
      </div>
      <div>
        <label class="block text-sm mb-1 font-medium">ساعت تحویل *</label>
        <input type="time" name="delivery_time" required class="w-full border rounded-lg px-3 py-2">
      </div>
    </div>

    <hr class="my-4">
    <h3 class="font-bold text-lg">اطلاعات حساب بانکی در ایران (برای واریز ریال)</h3>

    <div>
      <label class="block text-sm mb-1 font-medium">نام بانک *</label>
      <input type="text" name="iran_bank_name" required class="w-full border rounded-lg px-3 py-2"
             placeholder="مثلاً بانک ملت">
    </div>
    <div>
      <label class="block text-sm mb-1 font-medium">به نام (صاحب حساب) *</label>
      <input type="text" name="iran_account_holder" required class="w-full border rounded-lg px-3 py-2"
             placeholder="نام و نام خانوادگی صاحب حساب">
    </div>
    <div>
      <label class="block text-sm mb-1 font-medium">شماره کارت / حساب / شبا *</label>
      <input type="text" name="iran_card_or_sheba" required class="w-full border rounded-lg px-3 py-2 font-mono"
             placeholder="IR... یا شماره کارت">
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-gray-700">
      <p class="font-bold mb-2">اطلاعات مورد نیاز متقاضی:</p>
      <ul class="list-disc list-inside space-y-1.5 leading-relaxed">
        <li>انتقال وجه حداکثر <strong>۴۸ ساعت</strong> زمان خواهد برد.</li>
        <li>ارسال رسید واریزی به شماره واتساپ شما <strong>پس از ساعت ۲۳:۰۰</strong> انجام خواهد شد.</li>
        <li>از تماس‌های مکرر در خصوص پیگیری واریزی پیش از سپری شدن مهلت ۴۸ ساعته مذکور، جداً خودداری فرمایید.</li>
      </ul>
    </div>

    <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-lg hover:bg-green-700 font-medium">
      ثبت و دریافت رسید اعلام
    </button>
  </form>
</div>
<%- include('../partials/footer') %>

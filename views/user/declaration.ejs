<%- include('../partials/header') %>
<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-lg p-6">
  <h1 class="text-2xl font-bold mb-2">اعلامیه دریافت درام نقدی</h1>
  <p class="text-sm text-gray-600 mb-6">
    پس از آپلود رسید واریز، این اعلامیه را تکمیل کنید. سپس ادمین زمان مراجعه حضوری را اعلام خواهد کرد.
  </p>

  <% if (error) { %>
    <div class="bg-red-100 text-red-700 p-3 rounded mb-4"><%= error %></div>
  <% } %>

  <div class="bg-blue-50 rounded-lg p-3 mb-6 text-sm">
    <p>سفارش: <strong class="font-mono"><%= tx.transaction_code %></strong></p>
    <p>مبلغ واریزی: <strong><%= Number(tx.amount_from).toLocaleString() %> <%= tx.from_currency %></strong></p>
    <p>معادل دریافتی: <strong><%= Number(tx.amount_to).toLocaleString() %> <%= tx.to_currency %></strong></p>
    <% if (bank) { %>
    <p class="mt-1">واریز به: <%= bank.bank_name %> — <%= bank.account_holder %> — <span class="font-mono"><%= bank.card_number || bank.shaba %></span></p>
    <% } %>
  </div>

  <form method="POST" action="/order/<%= tx.transaction_code %>/declaration" class="space-y-4">
    <div>
      <label class="block text-sm mb-1 font-medium">شماره ملی *</label>
      <input type="text" name="national_id" required maxlength="20"
             class="w-full border rounded-lg px-3 py-2 font-mono" placeholder="کد ملی ۱۰ رقمی">
    </div>

    <div>
      <label class="block text-sm mb-1 font-medium">تاریخ واریز (تومان) *</label>
      <input type="date" name="deposit_date" required class="w-full border rounded-lg px-3 py-2">
    </div>

    <div>
      <label class="block text-sm mb-1 font-medium">از حساب خانم/آقا (نام صاحب حساب مبدأ) *</label>
      <input type="text" name="from_account_name" required class="w-full border rounded-lg px-3 py-2"
             placeholder="نام صاحب حسابی که از آن واریز کرده‌اید">
    </div>

    <div>
      <label class="block text-sm mb-1 font-medium">نام واریزکننده و تاریخ روز واریز *</label>
      <input type="text" name="depositor_name_date" required class="w-full border rounded-lg px-3 py-2"
             placeholder="مثلاً: علی محمدی — ۱۴۰۴/۰۶/۰۵">
    </div>

    <div>
      <label class="block text-sm mb-1 font-medium">شماره رهگیری رسید واریزی *</label>
      <input type="text" name="tracking_number" required class="w-full border rounded-lg px-3 py-2 font-mono"
             placeholder="شماره پیگیری بانکی">
    </div>

    <div>
      <label class="block text-sm mb-1 font-medium">تاریخ دریافت مبلغ (درام) *</label>
      <input type="date" name="receive_date" required class="w-full border rounded-lg px-3 py-2">
      <p class="text-xs text-gray-500 mt-1">معمولاً همان روز مراجعه حضوری یا تاریخ توافقی</p>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-gray-700 leading-relaxed">
      با ثبت این فرم اعلام می‌دارید که مبلغ را واریز کرده و معادل درام را به‌صورت نقد دریافت می‌نمایید و تمام دعاوی، مشکلات و اختلافات بعدی به عهده اینجانب می‌باشد.
    </div>

    <button type="submit" class="w-full bg-amber-600 text-white py-3 rounded-lg hover:bg-amber-700 font-medium">
      ثبت اعلامیه و دریافت رسید
    </button>
  </form>
</div>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-lg p-6">
  <h1 class="text-2xl font-bold mb-4">سفارش <%= tx.transaction_code %></h1>
  <div class="grid grid-cols-2 gap-4 mb-6 text-sm">
    <div><span class="text-gray-500">جفت:</span> <%= tx.pair %></div>
    <div><span class="text-gray-500">نرخ:</span> <%= tx.rate_used %></div>
    <div><span class="text-gray-500">مبلغ پرداختی:</span> <%= tx.amount_from %> <%= tx.from_currency %></div>
    <div><span class="text-gray-500">مبلغ دریافتی:</span> <%= Number(tx.amount_to).toLocaleString() %> <%= tx.to_currency %></div>
    <div><span class="text-gray-500"><%= t('status') %>:</span> <strong><%= t(tx.status) || tx.status %></strong></div>
    <% if (tx.pickup_time) { %>
    <div class="col-span-2 bg-green-50 p-3 rounded"><%= t('pickup_time') %>: <strong><%= tx.pickup_time %></strong></div>
    <% } %>
  </div>

  <% if (tx.status === 'pending_payment' && bank) { %>
  <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
    <h3 class="font-bold mb-2">اطلاعات واریز</h3>
    <p>بانک: <strong><%= bank.bank_name %></strong></p>
    <p>شماره کارت: <strong class="font-mono text-lg"><%= bank.card_number %></strong></p>
    <p>شبا: <strong class="font-mono"><%= bank.shaba %></strong></p>
    <p>صاحب حساب: <%= bank.account_holder %></p>
    <p class="text-sm text-red-600 mt-2">لطفاً دقیقاً مبلغ <%= tx.amount_from %> را واریز کنید و رسید را آپلود نمایید.</p>
  </div>
  <form method="POST" action="/order/<%= tx.transaction_code %>/upload-receipt" enctype="multipart/form-data" class="space-y-3">
    <label class="block text-sm"><%= t('upload_receipt') %></label>
    <input type="file" name="receipt" accept="image/*,.pdf" required class="w-full border rounded-lg px-3 py-2">
    <button type="submit" class="bg-green-600 text-white px-5 py-2 rounded-lg">ارسال رسید</button>
  </form>
  <% } %>

  <% if (tx.status === 'pending_declaration') { %>
  <div class="bg-amber-50 border border-amber-300 rounded-lg p-4 mb-4">
    <p class="font-bold text-amber-800 mb-2">مرحله بعد: تکمیل اعلامیه</p>
    <p class="text-sm text-gray-700 mb-3">رسید واریز شما دریافت شد. قبل از اعلام زمان مراجعه، لطفاً اعلامیه دریافت درام را تکمیل کنید.</p>
    <a href="/order/<%= tx.transaction_code %>/declaration" class="inline-block bg-amber-600 text-white px-5 py-2 rounded-lg hover:bg-amber-700">تکمیل اعلامیه</a>
  </div>
  <% } %>

  <% if (tx.declaration_filled) { %>
  <div class="mt-2 mb-4">
    <a href="/order/<%= tx.transaction_code %>/declaration-receipt" class="text-blue-600 underline text-sm">مشاهده / چاپ اعلامیه امضاشده</a>
  </div>
  <% } %>

  <% if (tx.receipt_path) { %>
  <div class="mt-4">
    <p class="text-sm text-gray-500">رسید آپلود شده:</p>
    <a href="<%= tx.receipt_path %>" target="_blank" class="text-blue-600">مشاهده رسید</a>
  </div>
  <% } %>

  <a href="/dashboard" class="inline-block mt-6 text-blue-600">← بازگشت به داشبورد</a>
</div>
<%- include('../partials/footer') %>

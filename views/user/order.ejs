<%- include('../partials/header') %>
<div class="panel stack" style="max-width:640px;margin:1rem auto">
  <h1 style="margin:0;font-size:1.25rem">سفارش <span class="ltr-num" dir="ltr"><%= tx.transaction_code %></span></h1>
  <div>
    وضعیت:
    <span class="status-badge <%= tx.status==='rejected'?'st-reject':(tx.status==='completed'?'st-done':(tx.status==='ready_pickup'?'st-ready':(tx.status==='pending_review'?'st-review':'st-pending'))) %>">
      <%= statusLabel(tx.status) %>
    </span>
  </div>
  <div class="muted" style="font-size:0.9rem;line-height:1.8">
    <div>جفت: <%= tx.pair %> · نرخ: <%= tx.rate_used %></div>
    <div>پرداختی: <%= Number(tx.amount_from).toLocaleString() %> <%= tx.from_currency %></div>
    <div>دریافتی: <%= Number(tx.amount_to).toLocaleString() %> <%= tx.to_currency %></div>
  </div>

  <% if (tx.office_date || tx.office_time || tx.office_address || tx.pickup_time) { %>
  <div class="box-card">
    <h3>وقت حضور در دفتر</h3>
    <div>📅 تاریخ: <%= tx.office_date || '—' %></div>
    <div>⏰ ساعت: <%= tx.office_time || tx.pickup_time || '—' %></div>
    <div>📍 آدرس: <%= tx.office_address || (typeof settings!=='undefined' && settings.address) || '—' %></div>
  </div>
  <% } %>

  <% if (tx.status === 'pending_payment' && bank) { %>
  <div class="box-card">
    <h3>اطلاعات واریز</h3>
    <p>بانک: <b><%= bank.bank_name %></b></p>
    <p>کارت: <b class="card-num" dir="ltr"><%= bank.card_number %></b></p>
    <p>شبا: <b class="card-num" dir="ltr"><%= bank.shaba %></b></p>
    <p>صاحب حساب: <%= bank.account_holder %></p>
  </div>
  <form method="POST" action="/order/<%= tx.transaction_code %>/upload-receipt" enctype="multipart/form-data" class="stack">
    <label class="label">آپلود رسید واریز</label>
    <input class="input" type="file" name="receipt" accept="image/*,.pdf" required>
    <button class="btn btn-gold" type="submit">ارسال رسید</button>
  </form>
  <% } %>

  <% if (tx.status === 'pending_declaration') { %>
  <a class="btn btn-gold" href="/order/<%= tx.transaction_code %>/declaration">تکمیل اعلامیه</a>
  <% } %>

  <% if (tx.status === 'rejected') { %>
  <div class="alert">رسید/اعلامیه رد شده است. با پشتیبانی تماس بگیرید یا سفارش جدید ثبت کنید.</div>
  <% } %>

  <% if (tx.declaration_filled) { %>
  <a class="btn btn-soft" href="/order/<%= tx.transaction_code %>/declaration-receipt">مشاهده / چاپ اعلامیه</a>
  <% } %>

  <a class="btn btn-ghost" href="/dashboard">داشبورد</a>
</div>
<%- include('../partials/footer') %>

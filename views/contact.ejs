<%- include('partials/header') %>
<div class="panel stack" style="max-width:560px;margin:1rem auto">
  <h1 style="margin:0">ارتباط با ما</h1>
  <div class="box-card">
    <h3>تلفن</h3>
    <div class="ltr-num" dir="ltr"><%= settings.phone %></div>
  </div>
  <div class="box-card">
    <h3>واتساپ</h3>
    <div class="ltr-num" dir="ltr"><%= settings.whatsapp %></div>
    <a class="btn btn-soft" style="margin-top:0.5rem" target="_blank" rel="noopener"
       href="https://wa.me/<%= String(settings.whatsapp||'').replace(/\D/g,'') %>">چت واتساپ</a>
  </div>
  <div class="box-card">
    <h3>آدرس دفتر</h3>
    <div><%= settings.address %></div>
    <% if (settings.map_url) { %>
      <a class="btn btn-ghost" style="margin-top:0.5rem" href="<%= settings.map_url %>" target="_blank">لوکیشن روی نقشه</a>
    <% } %>
  </div>
  <% if (settings.office_note) { %>
  <p class="muted"><%= settings.office_note %></p>
  <% } %>
</div>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="panel auth-card stack">
    <h1 style="margin:0;text-align:center;font-size:1.4rem"><%= t('register') %></h1>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="POST" action="/register" class="stack" data-phone-combine autocomplete="off">
      <div>
        <label class="label"><%= t('first_name') %> *</label>
        <input class="input" type="text" name="first_name" required>
      </div>
      <div>
        <label class="label"><%= t('last_name') %> *</label>
        <input class="input" type="text" name="last_name" required>
      </div>
      <div>
        <label class="label">شماره تماس *</label>
        <div style="display:flex;gap:0.4rem">
          <select id="cc-phone" data-cc class="input" style="max-width:9rem"></select>
          <input id="phone-local" data-local class="input" type="tel" required placeholder="XXXXXXXX" inputmode="tel" dir="ltr">
        </div>
        <input type="hidden" name="phone_am" data-full value="">
      </div>
      <div>
        <label class="label">واتساپ * (اجباری)</label>
        <div style="display:flex;gap:0.4rem">
          <select id="cc-wa" data-cc-wa class="input" style="max-width:9rem"></select>
          <input id="wa-local" data-local-wa class="input" type="tel" required placeholder="XXXXXXXX" inputmode="tel" dir="ltr">
        </div>
        <input type="hidden" name="whatsapp" data-full-wa value="">
      </div>
      <div>
        <label class="label"><%= t('password') %> * (حداقل ۶)</label>
        <input class="input" type="password" name="password" required minlength="6">
      </div>
      <div>
        <label class="label">کد امنیتی: <b dir="ltr"><%= captchaQuestion %></b> = ؟ *</label>
        <input type="hidden" name="captcha_token" value="<%= captchaToken %>">
        <input class="input" type="text" name="captcha_answer" required inputmode="numeric">
      </div>
      <button type="submit" class="btn btn-gold" style="width:100%"><%= t('submit') %></button>
    </form>
    <p class="muted" style="text-align:center;margin:0">قبلاً ثبت‌نام کرده‌اید؟ <a href="/login" style="color:var(--gold)"><%= t('login') %></a></p>
  </div>
</div>
<%- include('partials/footer') %>

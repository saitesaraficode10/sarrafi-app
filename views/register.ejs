<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="panel auth-card stack">
    <h1 style="margin:0;text-align:center;font-size:1.4rem"><%= t('register') %></h1>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="POST" action="/register" enctype="multipart/form-data" class="stack">
      <div>
        <label class="label"><%= t('first_name') %> *</label>
        <input class="input" type="text" name="first_name" required>
      </div>
      <div>
        <label class="label"><%= t('last_name') %> *</label>
        <input class="input" type="text" name="last_name" required>
      </div>
      <div>
        <label class="label"><%= t('phone') %> *</label>
        <input class="input" type="text" name="phone_am" required placeholder="+374...">
      </div>
      <div>
        <label class="label"><%= t('whatsapp') %></label>
        <input class="input" type="text" name="whatsapp">
      </div>
      <div>
        <label class="label"><%= t('passport') %> *</label>
        <input class="input" type="file" name="passport" accept="image/*,.pdf" required>
      </div>
      <div>
        <label class="label"><%= t('password') %> *</label>
        <input class="input" type="password" name="password" required minlength="6">
      </div>
      <button type="submit" class="btn btn-gold" style="width:100%"><%= t('submit') %></button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>

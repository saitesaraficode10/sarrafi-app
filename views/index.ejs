<%- include('partials/header') %>

<section class="fx-hero">
  <div class="fx-badge"><span class="dot"></span> نرخ‌های زنده و قابل معامله</div>
  <h1><%= t('welcome') %></h1>
  <p><%= t('rates') %> — درام، دلار، تومان، تتر و روبل با امکان تغییر دستی توسط صرافی</p>
</section>

<div class="rates-grid">
  <% rates.forEach(r => {
    const [from, to] = r.pair.split('_');
  %>
  <article class="rate-card">
    <div class="rate-pair">
      <span><%= from %> → <%= to %></span>
      <span class="chip"><%= r.source || 'live' %></span>
    </div>
    <div class="rate-row">
      <div class="rate-col">
        <div class="rate-label buy"><%= t('buy') %></div>
        <div class="rate-value"><%= Number(r.buy_rate).toLocaleString(undefined, { maximumFractionDigits: 6 }) %></div>
      </div>
      <div class="rate-col" style="text-align:end">
        <div class="rate-label sell"><%= t('sell') %></div>
        <div class="rate-value"><%= Number(r.sell_rate).toLocaleString(undefined, { maximumFractionDigits: 6 }) %></div>
      </div>
    </div>
    <div class="rate-meta"><%= r.updated_at || '' %></div>
  </article>
  <% }) %>
</div>

<% if (typeof user === 'undefined' || !user) { %>
<section class="fx-cta">
  <h2>شروع معامله</h2>
  <p>ثبت‌نام کنید، واریز انجام دهید و درام نقد یا حواله دریافت کنید</p>
  <div class="fx-cta-actions">
    <a class="btn btn-gold" href="/register"><%= t('register') %></a>
    <a class="btn btn-ghost" href="/login"><%= t('login') %></a>
  </div>
</section>
<% } else { %>
<section class="fx-cta">
  <h2>سلام <%= user.full_name || '' %></h2>
  <p>از داشبورد سفارش جدید ثبت کنید یا وضعیت تراکنش‌ها را ببینید</p>
  <div class="fx-cta-actions">
    <a class="btn btn-gold" href="/new-order"><%= t('new_order') %></a>
    <a class="btn btn-ghost" href="/dashboard"><%= t('dashboard') %></a>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>

<%- include('partials/header') %>
<section class="fx-hero">
  <div class="fx-badge"><span class="dot"></span> Live rates / نرخ‌های زنده</div>
  <h1><%= t('welcome') %></h1>
  <p>Exchange rates in FA & EN · نرخ تبدیل به فارسی و انگلیسی</p>
</section>

<div class="stats-bar">
  <div class="stat-pill">آنلاین الان <b id="stat-online">—</b></div>
  <div class="stat-pill">بازدید امروز <b id="stat-visits">—</b></div>
  <div class="stat-pill">کاربران <b id="stat-users" data-count="<%= typeof userCount!=='undefined'?userCount:0 %>"><%= typeof userCount!=='undefined'?userCount:0 %></b></div>
</div>

<div class="rates-grid">
  <% rates.forEach(r => {
    const labels = {
      USD_AMD: {fa:'دلار → درام', en:'USD → AMD'},
      USDT_AMD: {fa:'تتر → درام', en:'USDT → AMD'},
      IRR_AMD: {fa:'تومان → درام', en:'IRR/Toman → AMD'},
      RUB_AMD: {fa:'روبل → درام', en:'RUB → AMD'}
    };
    const L = labels[r.pair] || {fa:r.pair, en:r.pair};
  %>
  <article class="rate-card">
    <div class="rate-pair">
      <span><%= L.fa %></span>
      <span class="chip"><%= L.en %></span>
    </div>
    <div class="rate-row">
      <div class="rate-col">
        <div class="rate-label buy"><%= t('buy') %> / Buy</div>
        <div class="rate-value"><%= Number(r.buy_rate).toLocaleString(undefined, { maximumFractionDigits: 6 }) %></div>
      </div>
      <div class="rate-col" style="text-align:end">
        <div class="rate-label sell"><%= t('sell') %> / Sell</div>
        <div class="rate-value"><%= Number(r.sell_rate).toLocaleString(undefined, { maximumFractionDigits: 6 }) %></div>
      </div>
    </div>
    <div class="rate-meta"><%= r.pair %> · <%= r.updated_at || '' %></div>
  </article>
  <% }) %>
</div>

<% if (typeof user === 'undefined' || !user) { %>
<section class="fx-cta">
  <h2>شروع معامله</h2>
  <p>ثبت‌نام کنید، واریز انجام دهید و درام نقد دریافت کنید</p>
  <div class="fx-cta-actions">
    <a class="btn btn-gold" href="/register"><%= t('register') %></a>
    <a class="btn btn-ghost" href="/login"><%= t('login') %></a>
  </div>
</section>
<% } else { %>
<section class="fx-cta">
  <h2>سلام <%= user.first_name || '' %></h2>
  <div class="fx-cta-actions">
    <a class="btn btn-gold" href="/new-order"><%= t('new_order') %></a>
    <a class="btn btn-ghost" href="/dashboard"><%= t('dashboard') %></a>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>

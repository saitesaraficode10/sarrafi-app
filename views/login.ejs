<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="panel auth-card stack">
    <h1 style="margin:0;text-align:center;font-size:1.4rem"><%= t('login') %></h1>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <form method="POST" action="/login" class="stack" data-phone-combine autocomplete="off">
      <div>
        <label class="label">شماره تماس</label>
        <div style="display:flex;gap:0.4rem">
          <select id="cc-login" data-cc class="input" style="max-width:9rem"></select>
          <input id="login-local" data-local class="input" type="tel" required placeholder="XXXXXXXX" inputmode="tel" dir="ltr">
        </div>
        <input type="hidden" name="phone_am" data-full value="">
      </div>
      <div>
        <label class="label"><%= t('password') %></label>
        <input class="input" type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-gold" style="width:100%"><%= t('login') %></button>
    </form>
    <p class="muted" style="text-align:center;margin:0">حساب ندارید؟ <a href="/register" style="color:var(--gold)"><%= t('register') %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
